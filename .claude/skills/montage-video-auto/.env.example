# Copie ce fichier en « .env » (même dossier) puis remplis les valeurs.

# ElevenLabs : https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voix off (optionnel) : identifiant de voix ElevenLabs
ELEVENLABS_VOICE_ID=
# Modèle Scribe (laisser vide = scribe_v1)
ELEVENLABS_STT_MODEL=

# YouTube Data API v3 : identifiants OAuth « Application de bureau »
# Google Cloud Console > API et services > Identifiants
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Chaîne cible (ex. UCxxxxxxxx). L'envoi est refusé si le compte connecté n'est pas cette chaîne.
YOUTUBE_CHANNEL_ID=
# Où garder le jeton OAuth (vide = %USERPROFILE%\.montage-video-auto\youtube-token.json)
YOUTUBE_TOKEN_PATH=

# Dossier de musiques IA (sous-dossiers enquete, profond, fun)
MUSIC_DIR=

# Optionnel : chemins si les outils ne sont pas dans le PATH
FFMPEG_PATH=
FFPROBE_PATH=
PYTHON_PATH=
# Optionnel : Chrome headless à utiliser par Remotion (vide = téléchargé automatiquement)
REMOTION_BROWSER_EXECUTABLE=
